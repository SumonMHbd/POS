# GEMINI_API_KEY: Reserved for server-side capabilities injected by AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this applet is hosted (used for Shopify/WooCommerce webhook callback URLs).
APP_URL="MY_APP_URL"

# SESSION_SECRET: High-entropy secret for HMAC-SHA256 auth tokens and AES-256-GCM credential vault encryption.
# If left empty, server.ts automatically generates and persists a 64-byte cryptographic key in data/.platform-secret.
SESSION_SECRET=""

# Optional webhook signature secrets when verifying live Shopify / WooCommerce store webhooks
SHOPIFY_WEBHOOK_SECRET=""
WOOCOMMERCE_WEBHOOK_SECRET=""
